### Invalid (empty password)
PATCH {{baseUrl}}/users/bob
Content-Type: {{json}}
# Authorization: Bearer {{access_token}}

{
  "password": ""
}

### Update all fields
PATCH {{baseUrl}}/users/Tai8
Content-Type: {{json}}
Authorization: Bearer {{access_token}}

{
  "full_name": "Bob Full",
  "email": "bobfull@gmail.com",
  "password": "supersecret"
}


### Update password
PATCH {{baseUrl}}/users/Tai7
Content-Type: {{json}}
# Authorization: Bearer {{access_token}}

{
  "password": "newsecret123"
}

### Update only full name
PATCH {{baseUrl}}/users/Tai8
Content-Type: {{json}}
Authorization: Bearer {{access_token}}

{
  "full_name": "Only Name Changed"
}

### Update user (partial)
PATCH {{baseUrl}}/users/bob
Content-Type: {{json}}
# Authorization: Bearer {{access_token}}

{
  "full_name": "Bob Updated",
  "email": "bob_updated@gmail.com"
}

### Login user
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "username": "Tai8",
  "password": "12345678A@a"
}

### Renew access token
POST {{baseUrl}}/tokens/renew_access
Content-Type: application/json

{
  "refresh_token": "{{refresh_token}}"
}



### Create user
POST {{baseUrl}}/users
Content-Type: application/json

{
  "username": "Tai8",
  "password": "12345678A@a",
  "full_name": "Tai Vu",
  "email": "taiproe8@gmail.com"
}


###
POST http://localhost:8080/transfers
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "from_account_id": 155,
  "to_account_id": 150,
  "amount": 100,
  "currency": "EUR"
}


### List accounts – page 1
GET http://localhost:8080/accounts?page_id=1&page_size=9
Authorization: Bearer {{access_token}}


### ❌ Invalid page_id
GET http://localhost:8080/accounts?page_id=0&page_size=5


### ❌ Invalid page_size
GET http://localhost:8080/accounts?page_id=1&page_size=100

###
GET http://localhost:8080/accounts?page_id=10000&page_size=5


### Get account by ID
GET http://localhost:8080/accounts/14


### ❌ Invalid ID
GET http://localhost:8080/accounts/abc


### ❌ Not found
GET http://localhost:8080/accounts/999999

###
GET http://localhost:8080/accounts/-1




### Health check (optional)
GET http://localhost:8080/ping


### Create account – USD
POST http://localhost:8080/accounts
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "currency": "EUR"
}


### Create account – EUR
POST http://localhost:8080/accounts
Content-Type: application/json

{
  "owner": "bob",
  "currency": "EUR"
}


### ❌ Invalid currency (should return 400)
POST http://localhost:8080/accounts
Content-Type: application/json

{
  "owner": "charlie",
  "currency": "VND"
}


### ❌ Missing owner (should return 400)
POST http://localhost:8080/accounts
Content-Type: application/json

{
  "currency": "USD"
}
